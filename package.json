    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0"
  }
