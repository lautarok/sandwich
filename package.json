    "migrations:generate": "tsx --env-file=.env.development src/cmd/migrations/generate.ts --",
    "migrations:up": "tsx --env-file=.env.development src/cmd/migrations/up.ts --",
    "migrations:rollback": "tsx --env-file=.env.development src/cmd/migrations/rollback.ts --"
  },
