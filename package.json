  "scripts": {
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "coverage": "NODE_V8_COVERAGE=coverage tsx --test \"src/**/*.spec.ts\"",
    "start": "tsx --env-file=.env src/cmd/sandwich/index.ts",
